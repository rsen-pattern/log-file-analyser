# Snowflake Connection Configuration

# Snowflake Identity
SNOWFLAKE_USERNAME=YOUR.NAME@PATTERN.COM
SNOWFLAKE_ACCOUNT=WEDSQVX-PATTERN
SNOWFLAKE_ROLE=DATA_FANATICS_READ_ROLE

# Snowflake Session Context
SNOWFLAKE_WAREHOUSE=VIBE_CODE_WH
SNOWFLAKE_DATABASE=PATTERN_DB
SNOWFLAKE_SCHEMA=PUBLIC

# Snowflake Authentication Private Key
SNOWFLAKE_PRIVATE_KEY_PATH="C:\Users\YourName\Downloads\rsa_key.p8"

# Flask session signing (generate a random string for local dev)
FLASK_SECRET_KEY=change-me-in-production

# Pattern Bifrost — get a local dev key at https://compass.pattern.com/Generate_Key
BIFROST_API_KEY=
